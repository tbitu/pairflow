{
  "name": "Pairflow Devcontainer",
  "image": "ghcr.io/tbitu/pairflow-devcontainer:latest",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "runArgs": [
    "--add-host=host.docker.internal:host-gateway",
    "--security-opt", "label=disable"
  ],
  "mounts": [
    "source=pairflow-worktrees,target=/.pairflow-worktrees,type=volume",
    "source=pairflow-reasonix-state,target=/home/vscode/.reasonix,type=volume",
    "source=pairflow-opencode-state,target=/home/vscode/.config/opencode,type=volume",
    "source=pairflow-opencode-home,target=/home/vscode/.opencode,type=volume",
    "source=pairflow-npm-cache,target=/home/vscode/.npm,type=volume",
    "source=pairflow-pnpm-store,target=/home/vscode/.local/share/pnpm,type=volume"
  ],
  "containerEnv": {
    "UPSTREAM_URL": "${localEnv:PAIRFLOW_OPENAI_ENDPOINT:http://host.docker.internal:11434/v1}",
    "TARGET_MODEL": "${localEnv:PAIRFLOW_TARGET_MODEL:qwen3.8-27b:q8_0}",
    "BACKEND": "${localEnv:PAIRFLOW_BACKEND:ollama}",
    "UPSTREAM_API_KEY": "${localEnv:PAIRFLOW_UPSTREAM_API_KEY:}",
    "DEEPSEEK_API_KEY": "${localEnv:DEEPSEEK_API_KEY:}",
    "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY:}"
  },
  "postCreateCommand": "bash -c 'if [ -f /workspace/.devcontainer/init-container.sh ]; then bash /workspace/.devcontainer/init-container.sh; elif [ -f .devcontainer/init-container.sh ]; then bash .devcontainer/init-container.sh; else /usr/local/bin/init-container.sh; fi'",
  "postStartCommand": "bash -c 'if [ -f /workspace/.devcontainer/start-services.sh ]; then bash /workspace/.devcontainer/start-services.sh; elif [ -f .devcontainer/start-services.sh ]; then bash .devcontainer/start-services.sh; else /usr/local/bin/start-services.sh; fi'",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
